# Keep the build context small and secret-free.
# Shipped: pyproject.toml, uv.lock, src/, agent.py, scripts/, deploy/, .env.example.

# Virtualenv (host-specific absolute paths) + build/test caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Version control
.git/

# Secrets / local env  (.env.example is kept on purpose)
.env

# Tests are not needed in the runtime image
tests/
