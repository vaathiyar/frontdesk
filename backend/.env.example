# Copy to .env and fill in.
# App settings are prefixed RECEPTIONIST_; vendor credentials keep their standard names.

# --- Gemini (the reasoning model behind the graph) ---
GOOGLE_API_KEY=

# --- Google Cloud service account (Speech-to-Text + Text-to-Speech + Calendar) ---
# Two ways to supply the key with those APIs enabled. Set either; inline wins if both.
#
# Inline is the deploy channel: a platform can hold a variable but often cannot mount a
# file — Coolify refuses variable substitution in a compose volume source outright. It must
# be the whole key on ONE line:  jq -c . < service-account.json
#
# Leave it UNQUOTED or single-quoted here. Double quotes break it: the key's own quote
# characters end the value early, python-dotenv then fails to parse the line, and the
# variable goes missing without any error.
GOOGLE_CREDENTIALS_JSON=
# The path is the easier one locally. Keep the file out of the repo; backend/.creds/ is
# gitignored. Under Docker this is the path INSIDE the container, which compose does not
# mount for you.
GOOGLE_CREDENTIALS_FILE_PATH=/path/to/service-account.json

# --- LiveKit (self-hosted on your own server; NOT LiveKit Cloud) ---
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telnyx (the confirmation text) ---
# TELNYX_API_KEY is REQUIRED: the worker checks it at startup and refuses to run without
# it. Every call ends in a confirmation text, so a missing key would otherwise only show
# up after the caller had hung up, as a log line nobody reads.
#
# TELNYX_FROM_NUMBER is optional — but if you set it, it must be E.164 (leading '+'), or
# startup fails too.
#
# On a real call the text goes out FROM the number that was dialled, so the caller sees
# the business they rang. TELNYX_FROM_NUMBER is only the fallback for console/REPL runs
# where nothing was dialled. Every number that sends — each DID in deploy/sip/numbers.json
# included — must be assigned to a messaging profile in the Telnyx portal, or Telnyx
# rejects with `40300 Forbidden: the from number is not assigned to a messaging profile`.
# Canada-to-Canada on a Canadian long code needs no A2P/10DLC registration; sending to
# US numbers does (a sole-proprietor brand is ~$22 and usually approved same day).
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=+16045550000

# --- Google Calendar (required) ---
# JSON map of profile_id -> Google Calendar ID. EVERY registered profile needs an entry:
# the worker checks this at startup and refuses to run otherwise, rather than discovering
# a missing calendar with a caller on the line. There is no in-memory fallback.
# NOTE: this is a dict, and pydantic-settings MERGES dicts across sources — setting
# RECEPTIONIST_CALENDAR_IDS={} in the shell will NOT override what's in this file.
RECEPTIONIST_CALENDAR_IDS={"hvac": "your-hvac-calendar@group.calendar.google.com", "restaurant": "your-restaurant-calendar@group.calendar.google.com"}
# IANA timezone all booking and date reasoning happen in.
RECEPTIONIST_TIMEZONE=America/Vancouver

# --- CockroachDB (where finished calls live) ---
# REQUIRED. Paste the connection string from the CockroachDB Cloud console, password and
# all — the `postgresql://` scheme is rewritten to `cockroachdb+psycopg://` for you, and
# everything after it is left alone.
#
# APPEND `&sslrootcert=system` YOURSELF, as below. `sslmode=verify-full` naming no CA file
# sends libpq to `~/.postgresql/root.crt` alone and never the system trust store, so
# without it every container fails with "root certificate file does not exist".
#
# Both processes check this at startup and refuse to run without it: a call whose record
# cannot be saved fails after the caller has hung up, which is the failure nobody sees.
# Create the table first:  uv run alembic upgrade head
RECEPTIONIST_DATABASE_URL=postgresql://user:password@cluster.gcp-us-east1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full&sslrootcert=system

# --- The link in every confirmation text, and who may read it back ---
# PUBLIC_BASE_URL must point at the SPA, not at this backend: /c/{id} is a client-side
# route, and the page it renders is what calls GET /api/calls/{id} in turn. It also has to
# be reachable from a phone, so `localhost` is useless in a real text.
#
# CORS_ORIGINS is the SPA's origin, as the browser sends it. Locally you can leave the
# default: Vite proxies /api, so the browser only ever sees one origin.
RECEPTIONIST_PUBLIC_BASE_URL=http://localhost:5173
RECEPTIONIST_CORS_ORIGINS=["http://localhost:5173"]

# Model parameters (model, thinking level, token ceiling) and voice parameters
# (STT/TTS models, voice, VAD) are code constants — in src/receptionist/agent/graph.py and
# src/receptionist/agent/providers.py — deliberately not env-configurable.
