# Copy to .env and fill in. All keys are prefixed RECEPTIONIST_.

# Secret used to sign shareable call-detail links (HMAC). Change in any real deploy.
RECEPTIONIST_LINK_SECRET=dev-insecure-secret-change-me

# Reasoning layer. Any strong tool-calling model; swap freely.
RECEPTIONIST_LLM_MODEL=claude-opus-5
RECEPTIONIST_LLM_EFFORT=medium
RECEPTIONIST_LLM_MAX_TOKENS=4096

# Base URL the shareable hardlinks are built against.
RECEPTIONIST_PUBLIC_BASE_URL=http://localhost:8000

# The LLM call needs a credential. Either export ANTHROPIC_API_KEY, or run `ant auth login`.
# ANTHROPIC_API_KEY=sk-ant-...
