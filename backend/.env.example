# Copy to .env and fill in.
# App settings are prefixed RECEPTIONIST_; Google + LiveKit credentials keep their standard names.

# --- Gemini (the reasoning LLM) ---
GOOGLE_API_KEY=

# --- Google Cloud service account (Speech-to-Text + Text-to-Speech for the voice path) ---
# Path to a service-account JSON with the Cloud Speech-to-Text and Text-to-Speech APIs enabled.
# The google-cloud client libraries (used by the LiveKit Google plugin) read this automatically.
GOOGLE_CREDENTIALS_FILE_PATH=/path/to/service-account.json

# --- LiveKit (self-hosted on your own server; NOT LiveKit Cloud) ---
# Point at your Hetzner/Coolify livekit-server. wss:// in prod, ws:// for a local server.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Google Calendar (real booking backend; optional) ---
# JSON map of profile_id -> Google Calendar ID. A profile listed here books against that
# Google Calendar; any unset/omitted profile falls back to the in-memory fake calendar
# (so local `console` testing needs zero calendar setup — leave this unset).
# The service account in GOOGLE_CREDENTIALS_FILE_PATH must have the Google Calendar API
# enabled and each calendar shared with its email ("Make changes to events").
RECEPTIONIST_CALENDAR_IDS={"hvac": "your-calendar-id@group.calendar.google.com"}
# IANA timezone all calendar reasoning and booking happen in.
RECEPTIONIST_TIMEZONE=America/Vancouver

# --- Local dev ---
# Which profile `uv run agent.py console` uses when there is no SIP dispatch metadata.
RECEPTIONIST_PROFILE=hvac

# --- Links / web ---
RECEPTIONIST_LINK_SECRET=dev-insecure-secret-change-me
RECEPTIONIST_PUBLIC_BASE_URL=http://localhost:8000

# Chat model params (model, effort, max tokens) and voice params (STT/TTS models & voice,
# VAD) are code constants — in src/receptionist/agent/runner.py and
# src/receptionist/providers/factory.py respectively — deliberately not env-configurable.
