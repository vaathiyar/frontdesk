# Base URL the SPA prepends to /api/... requests.
#
# Leave empty for same-origin. In dev, Vite proxies /api -> http://localhost:8000
# (see vite.config.ts), so an empty value is correct there too. Set an absolute
# origin only when the SPA is served from a different host than the API.
VITE_API_BASE_URL=

# Render the bundled fixtures instead of calling the API for ids that start with
# "demo-". On by default in `npm run dev`; set to 1 to also enable it in a
# production build (useful for previewing the record page before the API is up).
VITE_USE_FIXTURES=
